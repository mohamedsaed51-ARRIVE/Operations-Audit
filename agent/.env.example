# ARRIVE AI Inventory & Audit Agent — Phase 2 (copy to .env; never commit real values)
DATABASE_URL=postgres://arrive:CHANGE_ME@127.0.0.1:5432/arrive_audit
TEST_DATABASE_URL=postgres://arrive:CHANGE_ME@127.0.0.1:5432/arrive_audit_test
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
# Directory for the original uploaded files (kept byte-identical; filenames are random).
UPLOAD_DIR=./data/uploads
# Phase 2 has no authentication. 'none' is refused in production unless ALLOW_UNAUTHENTICATED=true.
AUTH_MODE=none
# ALLOW_UNAUTHENTICATED=false
# Dev proxy target for the web app
# VITE_API_TARGET=http://127.0.0.1:3001
